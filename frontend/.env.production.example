# Vercel project variables for the frontend (Project Settings > Environment Variables).
# NAMES AND SHAPES ONLY. Only VITE_ variables reach the browser, so nothing secret belongs here.

# Clerk PUBLISHABLE key of the same instance the backend's CLERK_SECRET_KEY belongs to.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_REPLACE_ME

# Do NOT set CLERK_SECRET_KEY or any GOOGLE_* value on Vercel: the frontend never uses them.
# They belong only on the backend host (see backend/.env.production.example).
