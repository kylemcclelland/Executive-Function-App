APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost:5432/executive
# For password-free PostgreSQL URLs, POSTGRES_PASSWORD supplies the connection password.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
USER_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Devotions: verified Clerk user ids allowed to enter (editor) or approve and publish (approver)
# prayer content. Empty means nobody; see docs/devotions-architecture.md.
EDITOR_CLERK_USER_IDS=
APPROVER_CLERK_USER_IDS=
