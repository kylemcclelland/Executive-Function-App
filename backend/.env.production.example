# Railway service variables for the Optima Pars API. NAMES AND SHAPES ONLY: set the real values in
# the Railway dashboard (Variables). Never commit a filled-in copy of this file.
# Startup refuses to run if any of these is unsafe (see Settings.production_problems).

APP_ENV=production

# Neon: use the DIRECT (non-pooled) connection string. sslmode=require is mandatory.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Clerk (the instance whose keys the frontend uses). Dev keys (sk_test_...) work for a private
# staging deployment; production keys (sk_live_...) need your own domain.
CLERK_SECRET_KEY=
# The exact browser origin(s) that sign users in: the Vercel URL, later your custom domain.
CLERK_AUTHORIZED_PARTIES=https://YOUR-APP.vercel.app

# Same-origin through the Vercel /api rewrite, so no cross-origin browser calls are needed.
# Leave this EMPTY (but present) unless you add a second origin.
CORS_ORIGINS=
FRONTEND_URL=https://YOUR-APP.vercel.app

# Initial timezone for new accounts (IANA name).
USER_TIMEZONE=America/New_York

# Google Calendar (optional, all three together or none).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NEW key for this environment: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up somewhere safe. Losing it only means users reconnect Google Calendar.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Must match an Authorized redirect URI on the Google OAuth client exactly.
GOOGLE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/integrations/google-calendar/callback
