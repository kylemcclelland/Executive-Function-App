# Copy to .env (gitignored). Never commit real keys.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://executive@127.0.0.1:5432/executive_function
# Backend supplies POSTGRES_PASSWORD separately when DATABASE_URL omits a password.
POSTGRES_USER=executive
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=executive_function
USER_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Clerk authentication (https://dashboard.clerk.com -> your application -> API keys) ---
# Backend: verifies the session tokens the frontend sends. Provide the secret key, or the PEM
# public key ("JWKS Public Key" under API keys -> Show JWT public key) for networkless
# verification, or both. Without either, every protected endpoint answers 503.
CLERK_SECRET_KEY=
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
MIIB...
-----END PUBLIC KEY-----"
# Origins allowed in the token's `azp` claim. Defaults to CORS_ORIGINS. Use the exact origin you
# open in the browser (Clerk development instances work on localhost, not 127.0.0.1).
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# The frontend's publishable key goes in frontend/.env.local; see frontend/.env.example.

# --- Google Calendar (optional; see docs/google-calendar.md) ---
# Without all three of the next values the integration is simply not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens. Generate once and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Must exactly match an Authorized redirect URI on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google-calendar/callback
FRONTEND_URL=http://localhost:5173
